#!/bin/bash
set -e

if [ -z "$1" ]; then
  echo "Usage: git-retag <tag-name> [<commit>]"
  echo "Example: git-retag v1.2.3"
  echo "Example: git-retag v1.2.3 abc1234"
  exit 1
fi

TAG=$1
COMMIT=${2:-HEAD} # default to HEAD

echo "🔹 Removing old tag: $TAG"
git tag -d "$TAG" 2>/dev/null || true
git push origin ":refs/tags/$TAG" 2>/dev/null || true

echo "🏷️ Creating new tag: $TAG -> $COMMIT"
git tag "$TAG" "$COMMIT"

echo "⬆️ Pushing new tag to remote"
git push origin "$TAG"

echo "✅ Tag $TAG has been recreated successfully"
